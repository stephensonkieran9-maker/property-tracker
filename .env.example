# ── Hostaway API ─────────────────────────────────────────────
# Get these from Hostaway: Settings → Hostaway API
# (Account ID is the "client_id", API key is the "client_secret")
HOSTAWAY_ACCOUNT_ID=
HOSTAWAY_API_KEY=

# ── Loss tracking (Vercel Blob) ──────────────────────────────
# Auto-injected by Vercel when you add a Blob store to the project.
# Used to save a daily snapshot so removed properties can be detected.
# Leave blank locally — dev falls back to a local file (.data/state.json).
BLOB_READ_WRITE_TOKEN=

# Optional: protects the daily cron endpoint. Vercel Cron sends it as a
# Bearer token. Fine to leave blank.
CRON_SECRET=

# ── Demo mode ────────────────────────────────────────────────
# Leave the Hostaway vars blank (or set this to "1") to run with
# fake sample data — no API key required.
DEMO_MODE=
