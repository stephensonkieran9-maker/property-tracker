# ── Hostaway API ─────────────────────────────────────────────
# Get these from Hostaway: Settings → Hostaway API
# (Account ID is the "client_id", API key is the "client_secret")
HOSTAWAY_ACCOUNT_ID=
HOSTAWAY_API_KEY=

# ── Snapshot storage (Vercel KV / Upstash Redis) ─────────────
# Auto-injected by Vercel when you add a KV store to the project.
# Leave blank locally to run in DEMO mode with a local file store.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Cron protection ──────────────────────────────────────────
# Set any random string. Vercel Cron sends it as a Bearer token so
# only Vercel can trigger the daily snapshot.
CRON_SECRET=

# ── Demo mode ────────────────────────────────────────────────
# Set to "1" to force fake data even if a Hostaway key is present.
DEMO_MODE=
